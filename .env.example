# ================================
# TaskHive — Environment Variables
# Copy this file to .env and fill in your values

# ── NVIDIA NIM API Key (PRIMARY - Free) ───────────────────────────────────────
# Get your FREE key at: https://build.nvidia.com → click "Get API Key"
# Model used: meta/llama-3.3-70b-instruct
NVIDIA_API_KEY=nvapi-your_key_here

# ── Google Gemini API Key (Optional fallback) ─────────────────────────────────
# Get your key at: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# ── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=TaskHive
DEBUG=false
LOG_LEVEL=INFORT=8000

# Optional: Frontend URL for CORS (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000
